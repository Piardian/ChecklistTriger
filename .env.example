PORT=3000
TWELVE_DATA_API_KEY=your_twelvedata_api_key_here
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_REQUEST_TIMEOUT_MS=10000
REQUIRE_TELEGRAM_READINESS=false

DELIVERY_MAX_ATTEMPTS=3
DELIVERY_RETRY_BASE_DELAY_MS=5000
DELIVERY_RETRY_MAX_DELAY_MS=60000
DELIVERY_QUEUE_HEARTBEAT_MAX_AGE_MS=30000

ENABLE_TELEMETRY=true
TELEMETRY_DIRECTORY=telemetry
TWELVE_DATA_CREDITS_PER_MINUTE=8
TWELVE_DATA_RATE_LIMIT_SAFETY_MARGIN=1
TWELVE_DATA_MAX_RETRIES=2
TWELVE_DATA_RATE_LIMIT_WINDOW_BUFFER_MS=250

ENABLE_KILLZONE=true
ENABLE_PVP_KILLZONE_BYPASS=false
LONDON=true
LONDON_START=10:00
LONDON_END=19:00
NEWYORK=true
NEWYORK_START=15:00
NEWYORK_END=00:00
NY_CLOSE=true
NY_CLOSE_START=22:00
NY_CLOSE_END=00:00
